<?xml version="1.0" encoding="utf-8"?>
<!-- The blue gradient of the vendor's own app icon, left to right. Kept as a
     shape rather than a flat colour so the plate matches what people recognise
     from Shelly's app; angle 0 runs the gradient horizontally. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:endColor="#173F64"
        android:startColor="#347DB5"
        android:type="linear" />
</shape>
