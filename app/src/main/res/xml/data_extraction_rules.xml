<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted credentials: tied to this device's Keystore key, useless on another device -->
        <exclude domain="sharedpref" path="shelly_credentials.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="shelly_credentials.xml"/>
    </device-transfer>
</data-extraction-rules>
